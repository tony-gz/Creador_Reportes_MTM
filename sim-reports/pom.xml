<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.simreports</groupId>
    <artifactId>sim-reports</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>sim-reports</name>
    <description>
        Motor de parsing y coincidencia para el reporte mensual de consumo
        de SIMs (Fase 1 — sin Spring, ver specs 00-06). La capa Spring
        Boot (Fase 2) se agrega mas adelante, en un pom separado o en
        este mismo con dependencias adicionales.
    </description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.10.2</junit.version>
        <poi.version>5.2.5</poi.version>
    </properties>

    <dependencies>
        <!-- JUnit 5 (Jupiter) — necesario para todos los tests entregados
             desde el punto 1 del checklist (spec 06). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Apache POI — necesario desde el punto 4 (parser de Alestra):
             lectura de tablas nativas de Excel (XSSFSheet.getTables()) y
             de celdas con DataFormatter, ver spec 01/02. Scope normal
             (no "test"): el motor de parsing en si depende de POI, no
             solo los tests. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Necesario para que "mvn test" ejecute tests de JUnit 5
                 (el plugin por defecto de Maven no lo hace sin esto). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

</project>
